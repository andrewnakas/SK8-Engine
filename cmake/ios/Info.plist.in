<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
	<key>CFBundleIdentifier</key>
	<string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
	<key>CFBundleDisplayName</key>
	<string>Skate 3</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
	<key>CFBundleVersion</key>
	<string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
	<key>MinimumOSVersion</key>
	<string>${CMAKE_OSX_DEPLOYMENT_TARGET}</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- The 6 GB disc is staged into Documents over Finder file sharing rather
	     than shipped in the bundle; both keys are required for the app's
	     Documents directory to appear there and stay writable. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- Icons are loose PNGs in the bundle root rather than a compiled asset
	     catalog: the build is driven by Ninja, and actool is an Xcode build
	     phase we do not have. iOS resolves the @2x/@3x variants itself from
	     these base names. -->
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconFiles</key>
			<array>
				<string>AppIcon20x20</string>
				<string>AppIcon29x29</string>
				<string>AppIcon40x40</string>
				<string>AppIcon60x60</string>
			</array>
			<key>UIPrerenderedIcon</key>
			<false/>
		</dict>
	</dict>
	<key>CFBundleIconFiles</key>
	<array>
		<string>AppIcon20x20</string>
		<string>AppIcon29x29</string>
		<string>AppIcon40x40</string>
		<string>AppIcon60x60</string>
	</array>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>metal</string>
	</array>

	<!-- Landscape only: the game renders a fixed 16:9 guest framebuffer. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Opt into high frame rates on ProMotion iPhones. NOT because the game
	     should run above 60 - the guest stays capped at 60 - but to work around
	     a long-standing iOS bug where, on a ProMotion device, ANY touch halves
	     the frame rate: 120 -> 60, 60 -> 30. Reported since iOS 15 and still
	     open (Apple Developer Forums thread 695097); this is a touchscreen game,
	     so the halving is effectively permanent.

	     Without this key iOS holds the layer to a 60 fps ceiling, the halving
	     takes it to 30, and that is exactly what an iPhone 15 Pro Max measured:
	     p50 33.3 ms, an exact 2x the vblank, with the GPU idle at 4.6 ms and the
	     command processor never waiting on a fence. A 60 Hz iPhone 13 mini has
	     no ProMotion and is unaffected, which is why it holds a locked 60 while
	     far faster hardware does not - the split is the display, not the chip.

	     The documented workaround is to allow a rate above the target so the
	     halving lands ON the target: permit 120, ask the guest for 60, get 60.
	     The guest cap is unchanged (skate3_guest_fps_cap=60 with auto off), so
	     this does not add render work or heat. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>

	<!-- A storyboard-less launch screen; without any UILaunchScreen key iOS
	     letterboxes the app at a legacy resolution. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
</dict>
</plist>
